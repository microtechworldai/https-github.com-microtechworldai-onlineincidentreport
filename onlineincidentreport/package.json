{
  "name": "uss-incident-report-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web,tunnel\" -c \"blue,green,magenta\" \"npm run dev --workspace=@uss/api\" \"npm run dev --workspace=@uss/web\" \"node start-tunnel.js\"",
    "dev:local": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=@uss/api\" \"npm run dev --workspace=@uss/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api",
    "reset-admin-password": "npm run reset-admin-password --workspace=apps/api",
    "tunnel": "node start-tunnel.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "localtunnel": "^2.0.2",
    "typescript": "^5.4.5",
    "untun": "^0.2.2"
  }
}
