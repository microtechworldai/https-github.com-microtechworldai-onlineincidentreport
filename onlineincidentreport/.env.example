# ==============================================================================
# Ultimate Security Services (USS) Incident Report System - Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000

# Custom Domain Configuration
# Enter your custom domain here (e.g. incidents.mydomain.com)
APP_DOMAIN=incidents.mydomain.com
CORS_ORIGIN=https://incidents.mydomain.com

# Super Admin Initial Seed Credentials
# IMPORTANT: These will be used ONLY on the initial seed.
# You will be forced to change the password upon first login.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMeNow123!
SUPERADMIN_NAME=USS Operations Director

# Separate JWT Authentication Realms (Hard Isolation)
# Use cryptographically random 64-character strings in production!
JWT_ADMIN_SECRET=uss_admin_secret_super_secure_random_key_replace_in_production_987654321
JWT_GUARD_SECRET=uss_guard_secret_super_secure_random_key_replace_in_production_123456789

# Database Configuration (PostgreSQL)
# In Docker, use: postgresql://postgres:postgres_secure_pass@postgres:5432/uss_incidents
# For local fallback or standalone dev, file/memory sqlite is also supported
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/uss_incidents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=uss_incidents

# Storage Driver: "local" or "s3"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / Cloudflare R2 / MinIO Object Storage (if STORAGE_DRIVER=s3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=uss-incident-reports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Timezone Setting (Official Dubai Time)
TZ=Asia/Dubai
